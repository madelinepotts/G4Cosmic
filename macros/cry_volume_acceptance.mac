# 10k validation run for CRY generation conditioned on a detector logical volume.
# This is an enrichment sample, not an absolute-rate cosmic-ray simulation.
/g4cosmic/output/file g4cosmic_volume_test_10k.root
/run/initialize
/g4cosmic/source cry
/g4cosmic/cry/verbose 0
/g4cosmic/cry/acceptanceMode volume
/g4cosmic/cry/acceptanceVolume *ScintillatorLV_*
/g4cosmic/cry/maxAcceptanceTrials 10000
/g4cosmic/cry/apply
/run/beamOn 10000
