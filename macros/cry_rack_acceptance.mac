# Backward-compatible filename for the old rack-conditioned CRY validation run.
# Stage 4 replaced rack/hodoscope-specific acceptance with logical-volume
# acceptance. This WarpTrack example targets all scintillator logical volumes.
/g4cosmic/output/file g4cosmic_volume_test_10k.root
/run/initialize
/g4cosmic/source cry
/g4cosmic/cry/verbose 0
/g4cosmic/cry/acceptanceMode volume
/g4cosmic/cry/acceptanceVolume ScintillatorBarLV
/g4cosmic/cry/maxAcceptanceTrials 10000
/g4cosmic/cry/apply
/run/beamOn 10000
