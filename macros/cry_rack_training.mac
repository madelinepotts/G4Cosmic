# Acceptance-conditioned CRY sample for ML training/enrichment.
# Do not use this sample for absolute cosmic-ray rate measurements.
/g4cosmic/output/file g4cosmic_rack_training_1m.root
/run/initialize
/g4cosmic/source cry
/g4cosmic/cry/verbose 0
/g4cosmic/cry/acceptanceMode rack
/g4cosmic/cry/apply
/run/beamOn 1000000
