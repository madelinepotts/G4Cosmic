# Randomized single-primary source sampled from the surface of a logical volume.
# Useful for button/source fixtures where particles should originate on the
# source volume boundary rather than throughout its bulk.
/g4cosmic/output/file sample_surface.root
/g4cosmic/source sample
/g4cosmic/sample/particle mu-
/g4cosmic/sample/minEnergy 30 MeV
/g4cosmic/sample/maxEnergy 10 GeV
/g4cosmic/sample/logEnergy 1
/g4cosmic/sample/sourceVolume ScintillatorBarLV
/g4cosmic/sample/positionMode surface
/g4cosmic/sample/maxTheta 30 deg
/run/beamOn 1000
