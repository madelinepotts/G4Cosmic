# Acceptance-conditioned CRY sample for ML training/enrichment.
# This redraws CRY showers until at least one primary intersects a physical
# placement whose logical-volume name matches the configured pattern.
# Do not use this sample for absolute cosmic-ray rate measurements.
/g4cosmic/output/file g4cosmic_volume_training_1m.root
/run/initialize
/g4cosmic/source cry
/g4cosmic/cry/verbose 0
/g4cosmic/cry/acceptanceMode volume
/g4cosmic/cry/acceptanceVolume ScintillatorBarLV
/g4cosmic/cry/maxAcceptanceTrials 10000
/g4cosmic/cry/apply
/run/beamOn 1000000
