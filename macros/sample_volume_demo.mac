# Randomized single-primary source sampled from inside a logical volume.
# This is useful for simple embedded sources, button sources, calibration
# volumes, or source fixtures implemented as ordinary Geant4 geometry.
/g4cosmic/output/file sample_volume.root
/g4cosmic/source sample
/g4cosmic/sample/particle mu-
/g4cosmic/sample/minEnergy 30 MeV
/g4cosmic/sample/maxEnergy 10 GeV
/g4cosmic/sample/logEnergy 1
/g4cosmic/sample/sourceVolume ScintillatorBarLV
/g4cosmic/sample/positionMode volume
/g4cosmic/sample/maxTheta 30 deg
/run/beamOn 1000
