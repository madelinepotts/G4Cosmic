0 1   0.050  -0.040  1.900   0.010   0.020  -0.300    2.0
1 14 -0.100   0.050  1.900   0.020  -0.030  -3.000    0.0
2 5   0.120  -0.080  1.900  -0.060   0.010  -6.000    1.5
3 6  -0.180   0.140  1.900   0.020  -0.030 -10.000    0.0
